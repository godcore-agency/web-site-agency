---
---

<section class="cta-section orange-glow" id="contacto">
  <div class="container">
    <div class="cta-content animate-on-scroll">
      <span class="section-label">Empecemos</span>
      <h2 class="cta-title">¿Listo para crecer?</h2>
      <p class="cta-subtitle">Agenda una llamada con nuestro equipo y descubre cómo podemos escalar tu marca.</p>

      <form class="cta-form animate-on-scroll delay-1" onsubmit="return false;">
        <div class="cta-input-group">
          <input
            type="email"
            placeholder="tu@email.com"
            class="cta-input"
            required
            aria-label="Email address"
          />
          <button type="submit" class="btn btn-primary cta-btn">
            Agendar llamada
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#" class="footer-logo">
          <span class="logo-text">GODCORE AGENCY</span><span class="logo-dot">.</span>
        </a>
        <p class="footer-desc">Digital strategy, content, paid media & brand identity for ambitious companies.</p>
      </div>

      <div class="footer-links-group">
        <div class="footer-col">
          <h4 class="footer-heading">Navegación</h4>
          <ul class="footer-links">
            <li><a href="#servicios">Servicios</a></li>
            <li><a href="#proceso">Proceso</a></li>
            <li><a href="#planes">Planes</a></li>
            <li><a href="#resultados">Resultados</a></li>
            <li><a href="#faq">FAQ</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-heading">Contacto</h4>
          <ul class="footer-links">
            <li><a href="mailto:info@godcoreagency.com">info@godcoreagency.com</a></li>
            <li><a href="https://www.godcoreagency.com" target="_blank" rel="noopener">www.godcoreagency.com</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="footer-heading">Social</h4>
          <div class="footer-socials">
            <a href="#" aria-label="Instagram" class="social-link">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="16" height="16" rx="5"/>
                <circle cx="10" cy="10" r="4"/>
                <circle cx="15" cy="5" r="1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
            <a href="#" aria-label="LinkedIn" class="social-link">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="16" height="16" rx="3"/>
                <path d="M6 9v5M6 6v.01M10 14v-3.5a2 2 0 014 0V14M10 9v5"/>
              </svg>
            </a>
            <a href="#" aria-label="Behance" class="social-link">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7h4.5a2.5 2.5 0 010 5H3V7z"/>
                <path d="M3 12h5a2.5 2.5 0 010 5H3v-5z"/>
                <path d="M12 10.5a3 3 0 116 0v.5h-6"/>
                <line x1="12" y1="7" x2="18" y2="7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 GODCORE AGENCY. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .cta-section {
    padding: var(--section-padding) 0;
    padding-bottom: 80px;
  }

  .cta-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .cta-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-heading);
  }

  .cta-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-body);
    max-width: 500px;
    line-height: 1.6;
  }

  .cta-form {
    margin-top: 20px;
    width: 100%;
    max-width: 520px;
  }

  .cta-input-group {
    display: flex;
    gap: 12px;
    padding: 6px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cta-input {
    flex: 1;
    background: none;
    border: none;
    color: var(--color-white);
    font-family: var(--font-family);
    font-size: var(--font-size-sm);
    padding: 12px 20px;
    outline: none;
  }

  .cta-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .cta-btn {
    flex-shrink: 0;
  }

  /* Footer */
  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 64px 0 32px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 64px;
    margin-bottom: 48px;
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .logo-text {
    color: var(--color-heading);
  }

  .logo-dot {
    color: var(--color-accent);
    font-size: 1.8rem;
    line-height: 1;
  }

  .footer-desc {
    font-size: var(--font-size-sm);
    color: var(--color-gray);
    line-height: 1.7;
  }

  .footer-links-group {
    display: flex;
    gap: 64px;
  }

  .footer-heading {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-gray);
    font-weight: 500;
    margin-bottom: 20px;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: var(--font-size-sm);
    color: var(--color-body);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-white);
  }

  .footer-socials {
    display: flex;
    gap: 16px;
  }

  .social-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray);
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    color: var(--color-accent);
    border-color: rgba(var(--color-accent-rgb), 0.3);
    background: rgba(var(--color-accent-rgb), 0.08);
  }

  .footer-bottom {
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-bottom p {
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 768px) {
    .cta-input-group {
      flex-direction: column;
      border-radius: var(--radius-card);
      gap: 8px;
      padding: 12px;
    }

    .cta-input {
      padding: 12px 16px;
    }

    .cta-btn {
      width: 100%;
      justify-content: center;
    }

    .footer-top {
      flex-direction: column;
      gap: 40px;
    }

    .footer-links-group {
      flex-wrap: wrap;
      gap: 32px;
    }
  }
</style>
