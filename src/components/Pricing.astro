---
const plans = [
  {
    name: "SaaS",
    price: "$1'350.000",
    currency: "COP",
    description:
      "Ideal para emprendedores y negocios que inician su presencia digital.",
    featured: false,
    features: [
      "10 publicaciones al mes",
      "3 reels al mes",
      "Manejo de 1 red social",
      "Respuesta básica mensajería (precios, horarios, ubicación, servicios)",
      "Diseño básico",
      "Reporte mensual simple",
      "Landing page básico",
      "Diseño página web (UI/UX)",
      "Conexión redes sociales",
      "SEO básico",
    ],
    cta: "Empezar ahora",
  },
  {
    name: "Profesional",
    price: "$2'850.000",
    currency: "COP",
    description:
      "Para marcas que buscan escalar con estrategia y presencia sólida.",
    featured: false,
    badge: "Más Popular",
    features: [
      "Manejo de 2 redes mensual",
      "12 publicaciones al mes",
      "5 reels al mes",
      "Gestión de pauta (Meta Ads)",
      "Copywriting (Copys básicos)",
      "Reporte mensual mediano",
      "Respuesta mensajería",
      "Diseño gráfico simple",
      "Optimizaciones de software",
      "Diseño página web (UI/UX)",
      "Integración redes sociales (mensajes predefinidos)",
      "Análisis de posibles automatizaciones",
    ],
    cta: "Elegir Profesional",
  },
  {
    name: "Elite",
    price: "$5'350.000",
    currency: "COP",
    description:
      "Para empresas que necesitan resultados agresivos y automatización.",
    featured: true,
    badge: "Recomendado",
    features: [
      "Manejo de 3 redes mensual",
      "18 publicaciones al mes",
      "8 reels al mes",
      "Gestión de pauta (Meta Ads, Google Ads)",
      "Copywriting (Copys avanzado)",
      "Reporte mensual completo",
      "Respuesta mensajería",
      "Diseño gráfico avanzado",
      "Desarrollo sistemas web automatizados",
      "Diseño página web (UI/UX)",
      "Integración redes sociales",
      "Chatbot IA",
      "SEO avanzado",
      "Análisis, automatizaciones y flujos de trabajo",
      "Integraciones de Inteligencia Artificial",
    ],
    cta: "Elegir Elite",
  },
  {
    name: "GODCORE",
    price: "$8'100.000",
    currency: "COP",
    description: "El servicio más completo. Todo incluido, sin límites.",
    featured: false,
    badge: "Premium",
    features: [
      "Manejo de todas las redes mensual",
      "24 publicaciones al mes",
      "12 reels al mes",
      "Gestión de pauta (Meta Ads, Google Ads)",
      "Copywriting (Copys, Storytelling)",
      "Reporte mensual completo",
      "Respuesta mensajería",
      "Diseño gráfico con línea visual",
      "Desarrollos trimestrales a la medida (E Commerce, Pasarela pagos, sistemas, etc)",
      "Desarrollo panel administrativo marketing",
      "Integraciones de Inteligencia Artificial",
    ],
    cta: "Elegir GODCORE",
  },
  {
    name: "Personalizado",
    price: "A medida",
    currency: "",
    description:
      "Diseñamos un plan 100% adaptado a las necesidades de tu negocio.",
    featured: false,
    features: [
      "Manejo de redes según necesidades",
      "Publicaciones y reels definidas por el cliente",
      "Gestión de pauta (Meta Ads, Google Ads) opcional",
      "Copywriting (Copys o Storytelling)",
      "Reporte mensual (Básico o Avanzado)",
      "Respuesta mensajería (Básica o Avanzada)",
      "Diseño gráfico (Básico, Avanzado o Con línea visual)",
      "Desarrollo de sistemas personalizados",
      "Desarrollo panel administrativo según requerimientos",
      "Integración redes sociales",
      "Chatbot IA personalizados",
      "SEO avanzado",
      "Análisis, automatizaciones y flujos personalizados",
      "Integraciones de IA a la medida",
    ],
    cta: "Hablar con ventas",
  },
];

const mainPlans = plans.slice(0, 4);
const customPlan = plans[4];
---

<section class="pricing" id="planes">
  <div class="container">
    <div class="pricing-header animate-on-scroll">
      <span class="section-label">Planes</span>
      <h2 class="section-title">
        Inversión transparente,<br />resultados medibles.
      </h2>
      <p class="section-subtitle">
        Elige el plan que mejor se adapte a tu etapa de crecimiento.
      </p>
    </div>

    <!-- 4 Main Plans -->
    <div class="pricing-grid">
      {
        mainPlans.map((plan, i) => (
          <div
            class={`glass-card pricing-card ${plan.featured ? "featured" : ""} ${plan.name === "GODCORE" ? "godcore" : ""} animate-on-scroll delay-${i + 1}`}
          >
            {plan.badge && (
              <div
                class={`pricing-badge ${plan.name === "GODCORE" ? "badge-godcore" : ""}`}
              >
                {plan.badge}
              </div>
            )}
            <div class="pricing-card-header">
              <h3 class="plan-name">{plan.name}</h3>
              <div class="plan-price">
                <span class="price">{plan.price}</span>
                {plan.currency && <span class="currency">{plan.currency}</span>}
              </div>
              <p class="plan-desc">{plan.description}</p>
            </div>

            <ul class="plan-features">
              {plan.features.map((feature) => (
                <li class="plan-feature">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M3.5 8.5L6.5 11.5L12.5 4.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href="#contacto"
              class={`btn ${plan.featured ? "btn-primary" : plan.name === "GODCORE" ? "btn-godcore" : "btn-ghost"} pricing-cta`}
            >
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>

    <!-- Custom Plan (full-width) -->
    <div class="custom-plan-wrapper animate-on-scroll">
      <div class="glass-card custom-plan-card">
        <div class="custom-plan-left">
          <div class="custom-plan-header">
            <h3 class="plan-name">{customPlan.name}</h3>
            <div class="plan-price">
              <span class="price">{customPlan.price}</span>
            </div>
            <p class="plan-desc">{customPlan.description}</p>
          </div>
          <a href="#contacto" class="btn btn-primary pricing-cta custom-cta">
            {customPlan.cta}
          </a>
        </div>
        <div class="custom-plan-right">
          <ul class="plan-features custom-features">
            {
              customPlan.features.map((feature) => (
                <li class="plan-feature">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M3.5 8.5L6.5 11.5L12.5 4.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {feature}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="pricing-disclaimer animate-on-scroll">
      <div class="disclaimer-icon">
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="9" cy="9" r="8"></circle>
          <line x1="9" y1="8" x2="9" y2="13"></line>
          <circle cx="9" cy="5.5" r="0.5" fill="currentColor" stroke="none"
          ></circle>
        </svg>
      </div>
      <p>
        <strong>Nota:</strong> Los gastos de infraestructura (hosting, dominios, herramientas
        de terceros) y las inversiones en pauta publicitaria (Meta Ads, Google Ads,
        etc.) corren por cuenta del cliente y no están incluidos en los planes.
      </p>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: var(--section-padding) 0;
  }

  .pricing-header {
    margin-bottom: 64px;
  }

  /* --- 4-column grid for main plans --- */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .pricing-card {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .pricing-card.featured {
    border-color: rgba(var(--color-accent-rgb), 0.3);
    box-shadow:
      0 0 60px rgba(var(--color-accent-rgb), 0.1),
      inset 0 1px 0 rgba(var(--color-accent-rgb), 0.2);
  }

  .pricing-card.featured::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
  }

  .pricing-card.godcore {
    border-color: rgba(var(--color-accent-rgb), 0.15);
    background: rgba(var(--color-accent-rgb), 0.03);
  }

  .pricing-card.godcore::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    opacity: 0.6;
  }

  .pricing-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-white);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .badge-godcore {
    background: linear-gradient(135deg, var(--color-accent), #ff9f29);
  }

  .pricing-card-header {
    margin-bottom: 24px;
  }

  .plan-name {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-gray);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .pricing-card.godcore .plan-name {
    color: var(--color-accent);
    font-weight: 600;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .price {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-heading);
    line-height: 1.2;
  }

  .currency {
    font-size: var(--font-size-sm);
    color: var(--color-gray);
    font-weight: 400;
  }

  .plan-desc {
    font-size: var(--font-size-xs);
    color: var(--color-body);
    line-height: 1.6;
  }

  .plan-features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
    flex: 1;
  }

  .plan-feature {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--font-size-xs);
    color: var(--color-body);
    line-height: 1.5;
  }

  .plan-feature svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pricing-cta {
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }

  .btn-godcore {
    background: transparent;
    color: var(--color-accent);
    border: 1px solid rgba(var(--color-accent-rgb), 0.4);
  }

  .btn-godcore:hover {
    background: var(--color-accent);
    color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(var(--color-accent-rgb), 0.35);
  }

  /* --- Custom Plan (full-width) --- */
  .custom-plan-wrapper {
    margin-top: 20px;
  }

  .custom-plan-card {
    display: flex;
    gap: 48px;
    padding: 48px 48px;
    align-items: center;
    border-color: rgba(var(--color-accent-rgb), 0.12);
  }

  .custom-plan-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      rgba(255, 159, 41, 0.6),
      transparent
    );
  }

  .custom-plan-left {
    flex: 0 0 300px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .custom-plan-left .plan-name {
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--font-size-base);
  }

  .custom-plan-left .price {
    font-size: var(--font-size-2xl);
  }

  .custom-plan-left .plan-desc {
    font-size: var(--font-size-sm);
  }

  .custom-cta {
    width: auto;
    max-width: 260px;
  }

  .custom-plan-right {
    flex: 1;
  }

  .custom-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 32px;
    margin-bottom: 0;
  }

  /* --- Responsive --- */
  @media (max-width: 1280px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }

    .custom-plan-card {
      flex-direction: column;
      gap: 32px;
      padding: 32px 24px;
      align-items: stretch;
    }

    .custom-plan-left {
      flex: none;
    }

    .custom-cta {
      width: 100%;
      max-width: 100%;
    }

    .custom-features {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .custom-features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* --- Disclaimer --- */
  .pricing-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 48px;
    padding: 20px 24px;
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    max-width: auto;
  }

  .disclaimer-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pricing-disclaimer p {
    font-size: var(--font-size-xs);
    color: var(--color-gray);
    line-height: 1.7;
  }

  .pricing-disclaimer strong {
    color: var(--color-heading);
    font-weight: 600;
  }
</style>
